# Non-secret Hue collector settings for /opt/mcp-accounts/.env.config.
# HUE_KEY and HUE_BRIDGE_IP remain in /opt/mcp-accounts/.env. The database
# path is fixed by the systemd unit at /var/lib/hue-events/hue.sqlite3.

HUE_TIMEZONE=America/New_York
HUE_RETENTION_DAYS=30
HUE_RECONCILE_INTERVAL_SEC=300
HUE_METADATA_REFRESH_SEC=21600
HUE_READ_TIMEOUT_SEC=360
HUE_RECONNECT_MAX_SEC=60

# Optional CA file for verified Bridge TLS. Without it the local Bridge's
# certificate is accepted without verification, matching the existing client.
# HUE_CA_CERT=/path/to/hue-bridge-ca.pem
