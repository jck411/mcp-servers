[Unit]
Description=Knowledge wiki midday rebuild
After=network-online.target mcp-server@knowledge.service mcp-knowledge-api.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mcp-servers
EnvironmentFile=-/opt/mcp-servers/.env
ExecStart=/opt/mcp-servers/deploy/backup.sh --skip-healthcheck --skip-qdrant --skip-maintain
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mcp-knowledge-wiki-midday
