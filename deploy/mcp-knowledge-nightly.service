[Unit]
Description=Knowledge backup, maintenance, and wiki pipeline
After=network-online.target mcp-server@knowledge.service mcp-knowledge-api.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mcp-servers
EnvironmentFile=-/opt/mcp-servers/.env
ExecStart=/opt/mcp-servers/deploy/backup.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mcp-knowledge-nightly
